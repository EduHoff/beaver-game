@startuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Domain Enums" {
    enum CardColor {
        BLACK (0)
        RED (1)
    }

    enum PlayerState {
        ELIGIBLE
        STOPPED
        COLLAPSED
    }
}

package "Core Entities" {
    class Card {
        - color: CardColor
    }

    class Hand {
        - cards: List<Card>
        + add(cards: List<Card>)
        + remove(card: Card)
        + getCount(): int
        + hasRedCards(): boolean
    }

    class Sequence {
        - cards: List<Card>
        + appendRight(card: Card)
        + popLeft(): Card
        + removeAllReds()
        + removeAllBlacks()
        + clear()
        + getLength(): int
        + getLastCard(): Card
        + getRedCount(): int
    }

    class Player {
        - id: String
        - state: PlayerState
        - secretHand: Hand
        - publicSequence: Sequence
        + performMulligan()
        + playCard(index: int)
        + checkOverflow()
    }

    class Deck {
        - cards: List<Card>
        + shuffle()
        + draw(amount: int): List<Card>
        + add(cards: List<Card>)
        + isEmpty(): boolean
    }

    class GameMatch {
        - players: List<Player>
        - drawPile: Deck
        - discardPile: Deck
        - currentPlayerIndex: int
        + startMulliganPhase()
        + resolveTransition(prev: Card, current: Card)
        + checkEndCondition(): boolean
        + tallyVictory(): Player
    }
}

' Relationships
GameMatch "1" *-- "2..*" Player : contains
GameMatch "1" *-- "1" Deck : drawPile
GameMatch "1" *-- "1" Deck : discardPile

Player "1" *-- "1" Hand : owns
Player "1" *-- "1" Sequence : owns

Hand "1" o-- "*" Card : holds
Sequence "1" o-- "*" Card : holds
Deck "1" o-- "*" Card : holds

Card -> CardColor
Player -> PlayerState

@enduml
